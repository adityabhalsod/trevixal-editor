{
  "$schema": "https://typedoc.org/schema.json",
  "entryPointStrategy": "packages",
  "entryPoints": [
    "packages/angular",
    "packages/core",
    "packages/extension-blocks",
    "packages/extension-code-highlight",
    "packages/extension-diagram",
    "packages/extension-embed",
    "packages/extension-emoji",
    "packages/extension-export",
    "packages/extension-format-code",
    "packages/extension-image",
    "packages/extension-math",
    "packages/extension-security",
    "packages/extension-slash-command",
    "packages/extension-table",
    "packages/extension-track-changes",
    "packages/extension-workspace",
    "packages/extension-writing",
    "packages/editor-kit",
    "packages/react",
    "packages/svelte",
    "packages/ui",
    "packages/vue",
    "packages/web-component"
  ],
  "out": "docs/public/api",
  "name": "Trevixal API",
  "readme": "none",
  "includeVersion": false,
  "hideGenerator": true,
  "excludePrivate": true,
  "excludeInternal": true,
  "githubPages": false,
  "validation": {
    "notExported": false,
    "invalidLink": true,
    "notDocumented": false
  },
  "highlightLanguages": [
    "bash",
    "console",
    "css",
    "diff",
    "html",
    "javascript",
    "json",
    "jsonc",
    "jsx",
    "scss",
    "sh",
    "shell",
    "svelte",
    "tsx",
    "typescript",
    "vue",
    "yaml"
  ],
  "packageOptions": {
    "entryPoints": ["src/index.ts"],
    "entryPointStrategy": "expand"
  }
}
