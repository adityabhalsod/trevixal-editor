{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": {
    "ignore": [
      "**/dist/**",
      "**/node_modules/**",
      "**/.turbo/**",
      "**/coverage/**",
      "**/test-results/**",
      "**/playwright-report/**",
      "**/.next/**",
      "**/.nuxt/**",
      "**/.output/**",
      "**/.svelte-kit/**",
      "**/.data/**",
      "**/.vercel/**",
      "**/.vitepress/dist/**",
      "**/.vitepress/cache/**",
      "docs/public/api/**",
      "docs/public/trevixal/**",
      "examples/*/build/**",
      "examples/*/vendor/**",
      "**/next-env.d.ts",
      "packages/e2e/page/bundle.js",
      "packages/e2e/page/track-changes.js",
      "packages/e2e/page/ui.js",
      "packages/e2e/page/ui-styles.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "off",
        "noParameterAssign": "off"
      }
    }
  },
  "organizeImports": {
    "enabled": true
  },
  "overrides": [
    {
      "include": ["**/tsconfig*.json", "**/*.jsonc"],
      "json": { "parser": { "allowComments": true } }
    }
  ]
}
