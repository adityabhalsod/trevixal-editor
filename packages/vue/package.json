{
  "name": "@trevixal/vue",
  "version": "1.0.3",
  "description": "Vue 3 bindings for the Trevixal editor: useEditor composable, EditorContent component, shallow-ref snapshot.",
  "keywords": [
    "trevixal",
    "wysiwyg",
    "rich-text",
    "rich-text-editor",
    "editor",
    "typescript",
    "vue",
    "vue3",
    "composable",
    "bindings"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adityabhalsod/trevixal-editor.git",
    "directory": "packages/vue"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist", "!dist/**/*.map"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@trevixal/core": "workspace:^",
    "vue": ">=3.4.0"
  },
  "devDependencies": {
    "@trevixal/core": "workspace:*",
    "happy-dom": "^15.11.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0",
    "vue": "^3.5.13"
  }
}
