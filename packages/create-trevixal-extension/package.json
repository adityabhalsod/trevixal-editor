{
  "name": "create-trevixal-extension",
  "version": "1.0.3",
  "description": "Scaffold a Trevixal editor extension: a package with its schema, commands, menu entry and tests, laid out as the shipped extensions are.",
  "keywords": ["trevixal", "rich-text-editor", "editor", "extension", "scaffold", "create"],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adityabhalsod/trevixal-editor.git",
    "directory": "packages/create-trevixal-extension"
  },
  "type": "module",
  "sideEffects": false,
  "bin": {
    "create-trevixal-extension": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist", "!dist/**/*.map"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@trevixal/core": "workspace:*",
    "@trevixal/ui": "workspace:*",
    "@types/node": "^22.10.0",
    "happy-dom": "^15.11.7",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
