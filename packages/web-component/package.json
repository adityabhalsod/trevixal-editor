{
  "name": "@trevixal/web-component",
  "version": "1.0.2",
  "description": "The Trevixal editor as a <trevixal-editor> custom element, including a bundler-free CDN build.",
  "keywords": [
    "trevixal",
    "wysiwyg",
    "rich-text",
    "rich-text-editor",
    "editor",
    "typescript",
    "web-component",
    "custom-element",
    "cdn",
    "no-build"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adityabhalsod/trevixal-editor.git",
    "directory": "packages/web-component"
  },
  "type": "module",
  "sideEffects": [
    "./dist/trevixal-editor.iife.js"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./cdn": "./dist/trevixal-editor.iife.js"
  },
  "unpkg": "./dist/trevixal-editor.iife.js",
  "jsdelivr": "./dist/trevixal-editor.iife.js",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@trevixal/core": "workspace:^"
  },
  "devDependencies": {
    "@trevixal/core": "workspace:*",
    "happy-dom": "^15.11.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
