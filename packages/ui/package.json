{
  "name": "@trevixal/ui",
  "version": "2.0.0",
  "description": "Optional prebuilt UI for Trevixal: accessible toolbar and themes. Headless-first, bring your own UI if you prefer.",
  "keywords": [
    "trevixal",
    "wysiwyg",
    "rich-text",
    "rich-text-editor",
    "editor",
    "typescript",
    "toolbar",
    "themes",
    "accessible",
    "a11y"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adityabhalsod/trevixal-editor.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./scss/*": "./dist/scss/*"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && sass src/styles/index.scss dist/styles.css --no-source-map --no-charset --style=compressed && node -e \"require('node:fs').cpSync('src/styles','dist/scss',{recursive:true})\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@trevixal/core": "workspace:^"
  },
  "devDependencies": {
    "@trevixal/core": "workspace:*",
    "happy-dom": "^15.11.0",
    "sass": "^1.83.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
