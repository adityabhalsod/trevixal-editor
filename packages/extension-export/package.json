{
  "name": "@trevixal/extension-export",
  "version": "1.0.0",
  "description": "Import and export for the Trevixal editor: DOCX and RTF writers, a dependency-free DOCX reader, and file download helpers.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adityabhalsod/trevixal-editor.git",
    "directory": "packages/extension-export"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@trevixal/core": "workspace:^"
  },
  "devDependencies": {
    "@trevixal/core": "workspace:*",
    "happy-dom": "^15.11.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
