{
  "name": "@trevixal/extension-forms",
  "version": "1.0.3",
  "description": "Forms and mail merge for the Trevixal editor: content controls (text, checkbox, dropdown, date, signature), PDF form export, and one document per row of a CSV or JSON file.",
  "keywords": [
    "trevixal",
    "wysiwyg",
    "rich-text",
    "rich-text-editor",
    "editor",
    "typescript",
    "extension",
    "forms",
    "mail-merge",
    "pdf-forms"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adityabhalsod/trevixal-editor.git",
    "directory": "packages/extension-forms"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist", "!dist/**/*.map"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@trevixal/core": "workspace:^"
  },
  "devDependencies": {
    "@trevixal/core": "workspace:*",
    "happy-dom": "^15.11.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
